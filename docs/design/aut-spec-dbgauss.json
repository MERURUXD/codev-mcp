{
  "schema_version": 1,
  "kind": "aut_spec",
  "name": "dbgauss-multivariable-demo",
  "description": "Demonstration: eight curvatures and four air spaces of an 11-surface double Gauss laid out like the simulated backend's dbgauss model (stop on surface 6, F15 on surfaces 4 and 7, SK16 on 8 and 10) with focal length, length and image-distance constraints. All values are demonstration values. AUT runs only with the real backend: use your own lens with the same surface layout and adapt surface numbers and values.",
  "wall_seconds": 600,
  "stages": [
    {
      "name": "constrained",
      "variables": [
        {"surface": 1, "parameter": "radius"},
        {"surface": 2, "parameter": "radius"},
        {"surface": 3, "parameter": "radius"},
        {"surface": 5, "parameter": "radius"},
        {"surface": 7, "parameter": "radius"},
        {"surface": 9, "parameter": "radius"},
        {"surface": 10, "parameter": "radius"},
        {"surface": 11, "parameter": "radius"},
        {"surface": 2, "parameter": "thickness", "lower": 0.1, "upper": 5},
        {"surface": 5, "parameter": "thickness", "lower": 5},
        {"surface": 6, "parameter": "thickness", "lower": 5},
        {"surface": 9, "parameter": "thickness", "lower": 0.1, "upper": 5}
      ],
      "constraints": [
        {"operand": "EFL", "relation": "=", "value": 100, "source": "demonstration value"},
        {"operand": "OAL", "relation": "<", "value": 80, "source": "demonstration value"},
        {"operand": "IMD", "relation": ">", "value": 50, "source": "demonstration value"}
      ],
      "general_constraints": {"MNT": 2, "MNE": 1},
      "error_function": {"MXC": 30, "MNC": 1, "TAR": 0}
    }
  ]
}
